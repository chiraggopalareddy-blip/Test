// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Educational use only. Not financial advice. No indicator catches exact tops/bottoms every time.
//@version=5
indicator("Institutional Buy/Sell System", shorttitle="IBSS", overlay=true, max_labels_count=500, max_boxes_count=200, max_lines_count=100)

//══════════════════════════════════════════════════════════════════════════════
// INPUTS
//══════════════════════════════════════════════════════════════════════════════
grpCore = "Core Signal Engine"
pivotLeft     = input.int(3, "Pivot Left Bars", minval=1, maxval=10, group=grpCore, tooltip="Higher = fewer but more confirmed turns")
pivotRight    = input.int(3, "Pivot Right Bars", minval=1, maxval=10, group=grpCore, tooltip="Confirmation delay. 2–3 is a good balance.")
minPivotAtr   = input.float(0.35, "Min Swing Size (ATR)", minval=0.1, step=0.05, group=grpCore)
rsiLen        = input.int(14, "RSI Length", minval=5, group=grpCore)
rsiOb         = input.int(68, "RSI Overbought", minval=55, maxval=90, group=grpCore)
rsiOs         = input.int(32, "RSI Oversold", minval=10, maxval=45, group=grpCore)
stochLen      = input.int(14, "Stochastic Length", group=grpCore)
stochSmooth   = input.int(3, "Stochastic Smooth", group=grpCore)
requireDiv    = input.bool(false, "Require RSI Divergence (stricter)", group=grpCore)
requireRej    = input.bool(true, "Require Rejection Candle at Extreme", group=grpCore)
minScore      = input.int(4, "Min Reversal Score (0–7)", minval=3, maxval=7, group=grpCore)
cooldownBars  = input.int(5, "Min Bars Between Opposite Signals", minval=1, group=grpCore)

grpZone = "Intraday Dynamic Zones"
sessionOpenMin = input.int(30, "Opening Range Minutes", minval=5, maxval=120, group=grpZone, tooltip="First N minutes of the session form the opening range")
vwapBandMult   = input.float(1.0, "VWAP Band σ Multiplier", minval=0.5, step=0.1, group=grpZone)
zonePadAtr     = input.float(0.15, "Zone Padding (ATR)", minval=0.0, step=0.05, group=grpZone)
showZones      = input.bool(true, "Show Buy / Sell Zones", group=grpZone)
showVwap       = input.bool(true, "Show Session VWAP", group=grpZone)
showOr         = input.bool(true, "Show Opening Range", group=grpZone)

grpBias = "Bias Engine"
emaFastLen = input.int(9, "Fast EMA", group=grpBias)
emaMidLen  = input.int(21, "Mid EMA", group=grpBias)
emaSlowLen = input.int(50, "Slow EMA", group=grpBias)
adxLen     = input.int(14, "ADX Length", group=grpBias)
adxStrong  = input.float(25, "ADX Strong Trend", group=grpBias)
adxExtreme = input.float(35, "ADX Extreme Trend", group=grpBias)

grpVis = "Visuals"
showDashboard = input.bool(true, "Show Dashboard", group=grpVis)
bullColor     = input.color(#089981, "Buy Color", group=grpVis)
bearColor     = input.color(#F23645, "Sell Color", group=grpVis)
buyZoneColor  = input.color(color.new(#089981, 82), "Buy Zone Fill", group=grpVis)
sellZoneColor = input.color(color.new(#F23645, 82), "Sell Zone Fill", group=grpVis)
neutralZone   = input.color(color.new(#787B86, 88), "Balance Zone Fill", group=grpVis)

//══════════════════════════════════════════════════════════════════════════════
// SESSION / DAY CONTEXT
//══════════════════════════════════════════════════════════════════════════════
newDay = ta.change(time("D")) != 0

var float dayOpen = na
var float dayHigh = na
var float dayLow  = na
var int   dayStartBar = na
var float orHigh = na
var float orLow  = na
var bool  orDone = false

if newDay
    dayOpen := open
    dayHigh := high
    dayLow := low
    dayStartBar := bar_index
    orHigh := high
    orLow := low
    orDone := false
else
    dayHigh := math.max(nz(dayHigh, high), high)
    dayLow := math.min(nz(dayLow, low), low)

barsFromOpen = bar_index - nz(dayStartBar, bar_index)
// Opening-range bar count from chart TF (minutes-based intraday)
minsPerBar = timeframe.isseconds ? timeframe.multiplier / 60.0 : timeframe.isminutes ? float(timeframe.multiplier) : timeframe.isintraday ? float(timeframe.multiplier) : 60.0
orBarsNeeded = math.max(1, int(math.round(sessionOpenMin / math.max(minsPerBar, 0.25))))

if not orDone
    orHigh := math.max(nz(orHigh, high), high)
    orLow := math.min(nz(orLow, low), low)
    if barsFromOpen + 1 >= orBarsNeeded
        orDone := true

// Session VWAP + st.dev bands (resets daily)
var float vwapSumSrcVol = 0.0
var float vwapSumVol = 0.0
var float vwapSumSrc2Vol = 0.0
if newDay
    vwapSumSrcVol := hlc3 * volume
    vwapSumVol := volume
    vwapSumSrc2Vol := hlc3 * hlc3 * volume
else
    vwapSumSrcVol += hlc3 * volume
    vwapSumVol += volume
    vwapSumSrc2Vol += hlc3 * hlc3 * volume

sessVwap = vwapSumVol > 0 ? vwapSumSrcVol / vwapSumVol : hlc3
variance = vwapSumVol > 0 ? math.max(vwapSumSrc2Vol / vwapSumVol - sessVwap * sessVwap, 0.0) : 0.0
vwapDev = math.sqrt(variance)
vwapUpper = sessVwap + vwapDev * vwapBandMult
vwapLower = sessVwap - vwapDev * vwapBandMult

atr = ta.atr(14)
pad = atr * zonePadAtr

//══════════════════════════════════════════════════════════════════════════════
// DYNAMIC INTRADAY BUY / SELL ZONES
// Buy zone  = lower value area (OR low ∩ VWAP lower ∩ day low area)
// Sell zone = upper value area (OR high ∩ VWAP upper ∩ day high area)
// Zones update as the day develops.
//══════════════════════════════════════════════════════════════════════════════
// Dynamic zones: always buy below VWAP, sell above VWAP; widen with day extremes
buyRawTop = math.min(sessVwap - atr * 0.15, math.min(nz(orLow, low), vwapLower)) + pad
buyRawBot = math.min(nz(dayLow, low), buyRawTop) - pad
buyZoneTop = math.max(buyRawTop, buyRawBot)
buyZoneBot = math.min(buyRawTop, buyRawBot)

sellRawBot = math.max(sessVwap + atr * 0.15, math.max(nz(orHigh, high), vwapUpper)) - pad
sellRawTop = math.max(nz(dayHigh, high), sellRawBot) + pad
sellZoneTop = math.max(sellRawTop, sellRawBot)
sellZoneBot = math.min(sellRawTop, sellRawBot)

// Mid balance band around VWAP
balTop = sessVwap + atr * 0.25
balBot = sessVwap - atr * 0.25

inBuyZone  = low <= buyZoneTop and high >= buyZoneBot
inSellZone = high >= sellZoneBot and low <= sellZoneTop

var box buyBox = na
var box sellBox = na
var box balBox = na

if showZones and barstate.islast
    if not na(buyBox)
        box.delete(buyBox)
    if not na(sellBox)
        box.delete(sellBox)
    if not na(balBox)
        box.delete(balBox)
    left = nz(dayStartBar, bar_index - 50)
    buyBox := box.new(left, buyZoneTop, bar_index + 8, buyZoneBot, border_color=bullColor, bgcolor=buyZoneColor, border_width=1, text="BUY ZONE", text_color=bullColor, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center)
    sellBox := box.new(left, sellZoneTop, bar_index + 8, sellZoneBot, border_color=bearColor, bgcolor=sellZoneColor, border_width=1, text="SELL ZONE", text_color=bearColor, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center)
    balBox := box.new(left, balTop, bar_index + 8, balBot, border_color=color.new(#787B86, 50), bgcolor=neutralZone, border_width=1)

plot(showVwap ? sessVwap : na, "Session VWAP", color=color.new(#FF9800, 0), linewidth=2)
plot(showOr and orDone ? orHigh : na, "OR High", color=color.new(bearColor, 40), style=plot.style_linebr, linewidth=1)
plot(showOr and orDone ? orLow : na, "OR Low", color=color.new(bullColor, 40), style=plot.style_linebr, linewidth=1)

//══════════════════════════════════════════════════════════════════════════════
// TREND / BIAS (chart timeframe)
//══════════════════════════════════════════════════════════════════════════════
emaF = ta.ema(close, emaFastLen)
emaM = ta.ema(close, emaMidLen)
emaS = ta.ema(close, emaSlowLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

bullStack = emaF > emaM and emaM > emaS
bearStack = emaF < emaM and emaM < emaS
priceVsEma = close > emaS ? 1 : close < emaS ? -1 : 0
diBull = diPlus > diMinus
diBear = diMinus > diPlus

// Bias score -3..+3 then map to labels
biasScore = 0
biasScore += bullStack ? 1 : bearStack ? -1 : 0
biasScore += priceVsEma
biasScore += diBull ? 1 : diBear ? -1 : 0
// Stretch from VWAP adds conviction
biasScore += close > vwapUpper ? 1 : close < vwapLower ? -1 : 0
// Clamp
biasScore := math.max(-4, math.min(4, biasScore))

biasLabel = biasScore >= 3 and adx >= adxExtreme ? "EXTREMELY BULLISH" : biasScore >= 2 or (biasScore >= 1 and adx >= adxStrong and diBull) ? "BULLISH" : biasScore <= -3 and adx >= adxExtreme ? "EXTREMELY BEARISH" : biasScore <= -2 or (biasScore <= -1 and adx >= adxStrong and diBear) ? "BEARISH" : "NEUTRAL"

biasColor = biasLabel == "EXTREMELY BULLISH" ? #00C853 : biasLabel == "BULLISH" ? bullColor : biasLabel == "EXTREMELY BEARISH" ? #D50000 : biasLabel == "BEARISH" ? bearColor : #FFB300

plot(emaF, "EMA Fast", color=color.new(bullColor, 65))
plot(emaM, "EMA Mid", color=color.new(#787B86, 50))
plot(emaS, "EMA Slow", color=color.new(bearColor, 65))

//══════════════════════════════════════════════════════════════════════════════
// OSCILLATORS / DIVERGENCE / REJECTION
//══════════════════════════════════════════════════════════════════════════════
rsi = ta.rsi(close, rsiLen)
k = ta.stoch(close, high, low, stochLen)
d = ta.sma(k, stochSmooth)
volMa = ta.sma(volume, 20)
relVol = volMa > 0 ? volume / volMa : 1.0

// Pivot points for divergence & confirmed turns
ph = ta.pivothigh(high, pivotLeft, pivotRight)
pl = ta.pivotlow(low, pivotLeft, pivotRight)

var float lastPhPrice = na
var float lastPhRsi = na
var float lastPlPrice = na
var float lastPlRsi = na
var float prevPhPrice = na
var float prevPhRsi = na
var float prevPlPrice = na
var float prevPlRsi = na

bearDiv = false
bullDiv = false

if not na(ph)
    prevPhPrice := lastPhPrice
    prevPhRsi := lastPhRsi
    lastPhPrice := ph
    lastPhRsi := rsi[pivotRight]
    if not na(prevPhPrice) and not na(prevPhRsi)
        // Higher high in price, lower high in RSI
        bearDiv := lastPhPrice > prevPhPrice and lastPhRsi < prevPhRsi

if not na(pl)
    prevPlPrice := lastPlPrice
    prevPlRsi := lastPlRsi
    lastPlPrice := pl
    lastPlRsi := rsi[pivotRight]
    if not na(prevPlPrice) and not na(prevPlRsi)
        // Lower low in price, higher low in RSI
        bullDiv := lastPlPrice < prevPlPrice and lastPlRsi > prevPlRsi

// Rejection candles
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
body = math.abs(close - open)
range_ = high - low
bullReject = range_ > 0 and lowerWick >= range_ * 0.55 and body <= range_ * 0.35 and close >= open
bearReject = range_ > 0 and upperWick >= range_ * 0.55 and body <= range_ * 0.35 and close <= open

// Volume climax (exhaustion)
volClimax = relVol >= 1.8

// Extension fade: stretched from VWAP
stretchedUp = close >= vwapUpper
stretchedDn = close <= vwapLower

//══════════════════════════════════════════════════════════════════════════════
// REVERSAL SCORE AT CANDIDATE TOPS / BOTTOMS
// Uses confirmed pivots (lag = pivotRight) for accuracy over earliness.
//══════════════════════════════════════════════════════════════════════════════
pivotBarOffset = pivotRight  // kept for clarity; signals offset by this when pivot-confirmed

// Is this bar the confirmed pivot bar (right bars have printed)?
isPivotLowBar = not na(pl)
isPivotHighBar = not na(ph)

// Swing magnitude filter vs prior opposite pivot
swingOkLow = true
swingOkHigh = true
if isPivotLowBar and not na(lastPhPrice)
    swingOkLow := (lastPhPrice - pl) >= atr * minPivotAtr
if isPivotHighBar and not na(lastPlPrice)
    swingOkHigh := (ph - lastPlPrice) >= atr * minPivotAtr

// Score at pivot confirmation bar (evaluate conditions as of the pivot candle)
rsiAtPivot = rsi[pivotRight]
kAtPivot = k[pivotRight]
inBuyAtPivot = low[pivotRight] <= buyZoneTop[pivotRight] and high[pivotRight] >= buyZoneBot[pivotRight]
inSellAtPivot = high[pivotRight] >= sellZoneBot[pivotRight] and low[pivotRight] <= sellZoneTop[pivotRight]
pRange = high[pivotRight] - low[pivotRight]
pUpperWick = high[pivotRight] - math.max(open[pivotRight], close[pivotRight])
pLowerWick = math.min(open[pivotRight], close[pivotRight]) - low[pivotRight]
pBody = math.abs(close[pivotRight] - open[pivotRight])
bullRejectAtPivot = pRange > 0 and pLowerWick >= pRange * 0.5 and pBody <= pRange * 0.4
bearRejectAtPivot = pRange > 0 and pUpperWick >= pRange * 0.5 and pBody <= pRange * 0.4
volClimaxAtPivot = volume[pivotRight] >= volMa[pivotRight] * 1.6
stretchedDnAtPivot = close[pivotRight] <= vwapLower[pivotRight]
stretchedUpAtPivot = close[pivotRight] >= vwapUpper[pivotRight]
stochOsAtPivot = kAtPivot <= 25
stochObAtPivot = kAtPivot >= 75
rsiOsAtPivot = rsiAtPivot <= rsiOs
rsiObAtPivot = rsiAtPivot >= rsiOb

bottomScore = 0
topScore = 0

if isPivotLowBar
    bottomScore += 1  // confirmed swing low
    bottomScore += inBuyAtPivot ? 1 : 0
    bottomScore += rsiOsAtPivot ? 1 : 0
    bottomScore += stochOsAtPivot ? 1 : 0
    bottomScore += bullRejectAtPivot ? 1 : 0
    bottomScore += (bullDiv or stretchedDnAtPivot) ? 1 : 0
    bottomScore += (volClimaxAtPivot or biasScore >= 0) ? 1 : 0

if isPivotHighBar
    topScore += 1  // confirmed swing high
    topScore += inSellAtPivot ? 1 : 0
    topScore += rsiObAtPivot ? 1 : 0
    topScore += stochObAtPivot ? 1 : 0
    topScore += bearRejectAtPivot ? 1 : 0
    topScore += (bearDiv or stretchedUpAtPivot) ? 1 : 0
    topScore += (volClimaxAtPivot or biasScore <= 0) ? 1 : 0

bottomPass = isPivotLowBar and swingOkLow and bottomScore >= minScore and (not requireDiv or bullDiv) and (not requireRej or bullRejectAtPivot)
topPass = isPivotHighBar and swingOkHigh and topScore >= minScore and (not requireDiv or bearDiv) and (not requireRej or bearRejectAtPivot)

//══════════════════════════════════════════════════════════════════════════════
// ALTERNATING STATE MACHINE: BUY → SELL → BUY → …
// Also supports early zone-rejection flips when already in a position-state.
//══════════════════════════════════════════════════════════════════════════════
var int lastSide = 0          // 1 = last was BUY, -1 = last was SELL, 0 = flat
var int lastSigBar = na
var float lastSigPrice = na
var float lastBuyPrice = na
var float lastSellPrice = na

cooled = na(lastSigBar) or (bar_index - lastSigBar) >= cooldownBars

// Prefer zone + oscillator flips between confirmed pivots for tighter tops/bottoms
// Early entry (no pivot wait) only if very strong and alternate side required
earlyBuyScore = 0
earlyBuyScore += inBuyZone ? 2 : 0
earlyBuyScore += rsi <= rsiOs ? 1 : 0
earlyBuyScore += k <= 20 ? 1 : 0
earlyBuyScore += bullReject ? 1 : 0
earlyBuyScore += stretchedDn ? 1 : 0
earlyBuyScore += (bullStack or biasScore >= 1) ? 1 : 0
earlyBuyScore += volClimax and close > open ? 1 : 0

earlySellScore = 0
earlySellScore += inSellZone ? 2 : 0
earlySellScore += rsi >= rsiOb ? 1 : 0
earlySellScore += k >= 80 ? 1 : 0
earlySellScore += bearReject ? 1 : 0
earlySellScore += stretchedUp ? 1 : 0
earlySellScore += (bearStack or biasScore <= -1) ? 1 : 0
earlySellScore += volClimax and close < open ? 1 : 0

earlyBuy = earlyBuyScore >= minScore + 1 and close > open
earlySell = earlySellScore >= minScore + 1 and close < open

// Alternation rules — first signal (flat) must occur in the matching zone
canBuy  = (lastSide == -1 or (lastSide == 0 and (inBuyZone or bottomPass))) and cooled
canSell = (lastSide == 1 or (lastSide == 0 and (inSellZone or topPass))) and cooled

// Confirmed pivot signals preferred; early only if alternate needed and extreme
buySignal  = canBuy and (bottomPass or earlyBuy)
sellSignal = canSell and (topPass or earlySell)

// If both fire same bar (rare), prefer the one matching alternate need
if buySignal and sellSignal
    if lastSide == -1
        sellSignal := false
    else if lastSide == 1
        buySignal := false
    else
        // flat: take higher score
        if bottomScore + earlyBuyScore >= topScore + earlySellScore
            sellSignal := false
        else
            buySignal := false

if buySignal
    lastSide := 1
    lastSigBar := bar_index
    lastSigPrice := close
    lastBuyPrice := close
if sellSignal
    lastSide := -1
    lastSigBar := bar_index
    lastSigPrice := close
    lastSellPrice := close

// Reset side optionally on new day? Keep continuity across days for alternation.
// User asked buy must follow sell and vice versa — keep across days.

//══════════════════════════════════════════════════════════════════════════════
// PLOT SIGNALS AT PIVOT LOCATION WHEN CONFIRMED (more accurate tops/bottoms)
// For pivot signals, mark the actual pivot bar; for early, mark current bar.
//══════════════════════════════════════════════════════════════════════════════
buyIsPivot = buySignal and bottomPass
sellIsPivot = sellSignal and topPass

if buySignal
    label.new(buyIsPivot ? bar_index - pivotRight : bar_index, buyIsPivot ? low[pivotRight] : low, "BUY", style=label.style_label_up, color=bullColor, textcolor=color.white, size=size.small, yloc=yloc.price)
if sellSignal
    label.new(sellIsPivot ? bar_index - pivotRight : bar_index, sellIsPivot ? high[pivotRight] : high, "SELL", style=label.style_label_down, color=bearColor, textcolor=color.white, size=size.small, yloc=yloc.price)

plotshape(buySignal and not buyIsPivot, title="Early BUY", style=shape.circle, location=location.belowbar, color=bullColor, size=size.tiny)
plotshape(sellSignal and not sellIsPivot, title="Early SELL", style=shape.circle, location=location.abovebar, color=bearColor, size=size.tiny)

bgcolor(buySignal ? color.new(bullColor, 90) : sellSignal ? color.new(bearColor, 90) : na)

// Entry guidance lines from last signal
var line entryLine = na
if buySignal or sellSignal
    if not na(entryLine)
        line.set_x2(entryLine, bar_index)
    entryLine := line.new(bar_index, close, bar_index + 1, close, color=buySignal ? bullColor : bearColor, style=line.style_dashed, width=2)
if not na(entryLine)
    line.set_x2(entryLine, bar_index)

//══════════════════════════════════════════════════════════════════════════════
// ACTION PLAN TEXT (where to buy / sell today)
//══════════════════════════════════════════════════════════════════════════════
actionText = lastSide == 1 ? "Looking for SELL in SELL ZONE" : lastSide == -1 ? "Looking for BUY in BUY ZONE" : "Wait for first extreme (BUY or SELL)"

//══════════════════════════════════════════════════════════════════════════════
// DASHBOARD (top-right) — BIAS FIRST
//══════════════════════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 12, bgcolor=color.new(#0F1115, 5), border_width=1, border_color=color.new(#787B86, 55))

if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "BIAS", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 0, biasLabel, text_color=biasColor, text_size=size.small)

    table.cell(dash, 0, 1, "TF", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 1, timeframe.period, text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 2, "ADX", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(adx, "#.0"), text_color=adx >= adxStrong ? color.white : color.gray, text_size=size.tiny)

    table.cell(dash, 0, 3, "Next", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 3, lastSide == 1 ? "SELL only" : lastSide == -1 ? "BUY only" : "BUY or SELL", text_color=lastSide == 1 ? bearColor : lastSide == -1 ? bullColor : color.orange, text_size=size.tiny)

    table.cell(dash, 0, 4, "Action", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 4, actionText, text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 5, "Buy Zone", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(buyZoneBot, format.mintick) + " – " + str.tostring(buyZoneTop, format.mintick), text_color=bullColor, text_size=size.tiny)

    table.cell(dash, 0, 6, "Sell Zone", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 6, str.tostring(sellZoneBot, format.mintick) + " – " + str.tostring(sellZoneTop, format.mintick), text_color=bearColor, text_size=size.tiny)

    table.cell(dash, 0, 7, "VWAP", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 7, str.tostring(sessVwap, format.mintick), text_color=#FF9800, text_size=size.tiny)

    table.cell(dash, 0, 8, "In Zone", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 8, inBuyZone ? "BUY ZONE" : inSellZone ? "SELL ZONE" : "MID", text_color=inBuyZone ? bullColor : inSellZone ? bearColor : color.gray, text_size=size.tiny)

    table.cell(dash, 0, 9, "Bot Score", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 9, str.tostring(math.max(bottomScore, earlyBuyScore)) + " / 7", text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 10, "Top Score", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 10, str.tostring(math.max(topScore, earlySellScore)) + " / 7", text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 11, "Last", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 11, lastSide == 1 ? "BUY @ " + str.tostring(lastBuyPrice, format.mintick) : lastSide == -1 ? "SELL @ " + str.tostring(lastSellPrice, format.mintick) : "—", text_color=lastSide == 1 ? bullColor : lastSide == -1 ? bearColor : color.gray, text_size=size.tiny)

//══════════════════════════════════════════════════════════════════════════════
// ALERTS
//══════════════════════════════════════════════════════════════════════════════
alertcondition(buySignal, title="BUY Signal", message="IBSS BUY on {{ticker}} @ {{close}} | Bias: check dashboard | Buy Zone active")
alertcondition(sellSignal, title="SELL Signal", message="IBSS SELL on {{ticker}} @ {{close}} | Bias: check dashboard | Sell Zone active")
alertcondition(buySignal or sellSignal, title="Any Signal", message="IBSS signal on {{ticker}} @ {{close}}")
