// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Non-repainting confirmed-pivot engine. Educational use only — not financial advice.
//@version=5
indicator("Institutional Algo Buy/Sell", shorttitle="IALGO", overlay=true, max_labels_count=500, max_boxes_count=50, max_lines_count=50)

//══════════════════════════════════════════════════════════════════════════════
// INPUTS
//══════════════════════════════════════════════════════════════════════════════
grpSig = "Signal Engine (Non-Repaint)"
leftBars      = input.int(5, "Pivot Left", minval=2, maxval=15, group=grpSig, tooltip="Bars to the left of the swing. Higher = major swings only.")
rightBars     = input.int(3, "Pivot Right (confirm)", minval=2, maxval=10, group=grpSig, tooltip="Bars that must close beyond the swing before a signal. No repaint after confirm.")
minSwingAtr   = input.float(1.0, "Min Swing (ATR)", minval=0.4, step=0.1, group=grpSig, tooltip="Ignore tiny pivots. 1.0–1.5 cuts most fake turns.")
minReverseAtr = input.float(0.8, "Min Move From Last Signal (ATR)", minval=0.3, step=0.1, group=grpSig)
rsiLen        = input.int(14, "RSI Length", group=grpSig)
rsiBuyMax     = input.int(40, "BUY: RSI must be ≤", minval=20, maxval=50, group=grpSig)
rsiSellMin    = input.int(60, "SELL: RSI must be ≥", minval=50, maxval=80, group=grpSig)
useDivFilter  = input.bool(true, "Prefer RSI Divergence (bonus)", group=grpSig)
useTrendGate  = input.bool(true, "Trend Gate (block counter-trend fakes)", group=grpSig)
adxLen        = input.int(14, "ADX Length", group=grpSig)
adxTrend      = input.float(22.0, "ADX Trend Threshold", group=grpSig)
adxChop       = input.float(18.0, "ADX Chop Threshold", group=grpSig)
adxExtreme    = input.float(32.0, "ADX Extreme Threshold", group=grpSig)

grpZone = "Intraday Zones / Projections"
orMinutes     = input.int(30, "Opening Range (minutes)", minval=5, maxval=90, group=grpZone)
adrLen        = input.int(14, "ADR Length (days)", minval=5, maxval=30, group=grpZone)
showZones     = input.bool(true, "Show Buy/Sell Zones", group=grpZone)
showVwap      = input.bool(true, "Show Session VWAP", group=grpZone)
showProj      = input.bool(true, "Show Projected Day High/Low", group=grpZone)
showTradeLvls = input.bool(true, "Show Active Entry/Stop/Targets", group=grpZone)

grpRisk = "Trade Management"
stopAtrMult   = input.float(0.6, "Stop Distance (ATR beyond swing)", minval=0.2, step=0.1, group=grpRisk)
t1R           = input.float(1.5, "Target 1 (R-multiple)", minval=0.5, step=0.1, group=grpRisk)
t2R           = input.float(2.5, "Target 2 (R-multiple)", minval=1.0, step=0.1, group=grpRisk)

grpVis = "Visuals"
bullCol = input.color(#089981, "Buy", group=grpVis)
bearCol = input.color(#F23645, "Sell", group=grpVis)
zoneBuy = input.color(color.new(#089981, 88), "Buy Zone", group=grpVis)
zoneSell= input.color(color.new(#F23645, 88), "Sell Zone", group=grpVis)

//══════════════════════════════════════════════════════════════════════════════
// CORE SERIES
//══════════════════════════════════════════════════════════════════════════════
atr = ta.atr(14)
ema9  = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
rsi = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

bullStack = ema9 > ema21 and ema21 > ema50
bearStack = ema9 < ema21 and ema21 < ema50
diBull = diPlus > diMinus
diBear = diMinus > diPlus

//══════════════════════════════════════════════════════════════════════════════
// SESSION / VWAP / OPENING RANGE / ADR PROJECTION
//══════════════════════════════════════════════════════════════════════════════
newDay = ta.change(time("D")) != 0

var float dayOpen = na
var float dayHigh = na
var float dayLow  = na
var int   dayStartBar = na
var float orHigh = na
var float orLow = na
var bool  orLocked = false

if newDay
    dayOpen := open
    dayHigh := high
    dayLow := low
    dayStartBar := bar_index
    orHigh := high
    orLow := low
    orLocked := false
else
    dayHigh := math.max(nz(dayHigh, high), high)
    dayLow := math.min(nz(dayLow, low), low)

minsPerBar = timeframe.isseconds ? timeframe.multiplier / 60.0 : timeframe.isminutes ? float(timeframe.multiplier) : timeframe.isintraday ? float(timeframe.multiplier) : 60.0
orBars = math.max(1, int(math.round(orMinutes / math.max(minsPerBar, 0.25))))
barsFromOpen = bar_index - nz(dayStartBar, bar_index)

if not orLocked
    orHigh := math.max(nz(orHigh, high), high)
    orLow := math.min(nz(orLow, low), low)
    if barsFromOpen + 1 >= orBars
        orLocked := true

// Session VWAP
var float sumPV = 0.0
var float sumV = 0.0
if newDay
    sumPV := hlc3 * volume
    sumV := volume
else
    sumPV += hlc3 * volume
    sumV += volume
vwap = sumV > 0 ? sumPV / sumV : hlc3

// Daily ADR via non-lookahead security
dailyRange = request.security(syminfo.tickerid, "D", high - low, barmerge.gaps_off, barmerge.lookahead_off)
adr = request.security(syminfo.tickerid, "D", ta.sma(high - low, adrLen), barmerge.gaps_off, barmerge.lookahead_off)

// Projected day high/low (institutional hybrid: Open±ADR + IB expansion)
orRange = nz(orHigh - orLow, atr)
ibProjHigh = nz(orHigh, dayHigh) + orRange
ibProjLow  = nz(orLow, dayLow) - orRange
adrProjHigh = nz(dayOpen, open) + nz(adr, atr * 4)
adrProjLow  = nz(dayOpen, open) - nz(adr, atr * 4)
projHigh = math.max(adrProjHigh, ibProjHigh)
projLow  = math.min(adrProjLow, ibProjLow)
projRange = projHigh - projLow

// Dynamic buy/sell zones for the day (tighten as price discovers extremes)
buyTopRaw = math.min(vwap, math.min(nz(orLow, low), nz(dayOpen, open)))
buyBotRaw = math.min(nz(dayLow, low), projLow)
buyZoneTop = math.max(buyTopRaw, buyBotRaw)
buyZoneBot = math.min(buyTopRaw, buyBotRaw)
sellBotRaw = math.max(vwap, math.max(nz(orHigh, high), nz(dayOpen, open)))
sellTopRaw = math.max(nz(dayHigh, high), projHigh)
sellZoneTop = math.max(sellTopRaw, sellBotRaw)
sellZoneBot = math.min(sellTopRaw, sellBotRaw)

inBuyZone  = low <= buyZoneTop
inSellZone = high >= sellZoneBot

plot(showVwap ? vwap : na, "VWAP", color=color.new(#FF9800, 0), linewidth=2)
plot(showProj ? projHigh : na, "Proj High", color=color.new(bearCol, 55), style=plot.style_linebr, linewidth=1)
plot(showProj ? projLow : na, "Proj Low", color=color.new(bullCol, 55), style=plot.style_linebr, linewidth=1)

var box bBuy = na
var box bSell = na
if showZones and barstate.islast
    if not na(bBuy)
        box.delete(bBuy)
    if not na(bSell)
        box.delete(bSell)
    left = nz(dayStartBar, bar_index - 40)
    bBuy := box.new(left, buyZoneTop, bar_index + 5, buyZoneBot, border_color=bullCol, bgcolor=zoneBuy, border_width=1, text="BUY ZONE", text_size=size.tiny, text_color=bullCol, text_halign=text.align_right)
    bSell := box.new(left, sellZoneTop, bar_index + 5, sellZoneBot, border_color=bearCol, bgcolor=zoneSell, border_width=1, text="SELL ZONE", text_size=size.tiny, text_color=bearCol, text_halign=text.align_right)

//══════════════════════════════════════════════════════════════════════════════
// BIAS (chart timeframe)
// Buy | Sell | Neutral | Chop | Extremely Bullish | Extremely Bearish
//══════════════════════════════════════════════════════════════════════════════
bias = "Neutral"
if adx < adxChop
    bias := "Chop"
else if adx >= adxExtreme and bullStack and diBull and close > vwap
    bias := "Extremely Bullish"
else if adx >= adxExtreme and bearStack and diBear and close < vwap
    bias := "Extremely Bearish"
else if bullStack and diBull and close > ema21
    bias := "Buy"
else if bearStack and diBear and close < ema21
    bias := "Sell"
else
    bias := "Neutral"

biasCol = bias == "Extremely Bullish" ? #00E676 : bias == "Buy" ? bullCol : bias == "Extremely Bearish" ? #FF1744 : bias == "Sell" ? bearCol : bias == "Chop" ? #FFD600 : #B0BEC5

//══════════════════════════════════════════════════════════════════════════════
// NON-REPAINTING PIVOTS + RSI DIVERGENCE
// Signal is only evaluated on the confirmation bar (rightBars after the swing).
// Label is drawn at the historical swing bar — price does not change afterward.
//══════════════════════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)

var float lastPh = na
var float lastPl = na
var float prevPh = na
var float prevPl = na
var float lastPhRsi = na
var float lastPlRsi = na
var float prevPhRsi = na
var float prevPlRsi = na

bearDiv = false
bullDiv = false

if not na(ph)
    prevPh := lastPh
    prevPhRsi := lastPhRsi
    lastPh := ph
    lastPhRsi := rsi[rightBars]
    if not na(prevPh) and not na(prevPhRsi)
        bearDiv := lastPh > prevPh and lastPhRsi < prevPhRsi

if not na(pl)
    prevPl := lastPl
    prevPlRsi := lastPlRsi
    lastPl := pl
    lastPlRsi := rsi[rightBars]
    if not na(prevPl) and not na(prevPlRsi)
        bullDiv := lastPl < prevPl and lastPlRsi > prevPlRsi

// Pivot candle metrics (at the actual swing bar)
pHigh = high[rightBars]
pLow = low[rightBars]
pClose = close[rightBars]
pOpen = open[rightBars]
pRsi = rsi[rightBars]
pRange = pHigh - pLow
pUpper = pHigh - math.max(pOpen, pClose)
pLower = math.min(pOpen, pClose) - pLow
bullReject = pRange > 0 and pLower >= pRange * 0.45
bearReject = pRange > 0 and pUpper >= pRange * 0.45

// Near day / projection extremes (institutional location filter)
nearDayLow  = pLow <= nz(dayLow[rightBars], pLow) + atr * 0.35 or pLow <= projLow + atr * 0.5 or pLow <= buyZoneTop[rightBars]
nearDayHigh = pHigh >= nz(dayHigh[rightBars], pHigh) - atr * 0.35 or pHigh >= projHigh - atr * 0.5 or pHigh >= sellZoneBot[rightBars]

//══════════════════════════════════════════════════════════════════════════════
// ALTERNATING ZIGZAG STATE — BUY then SELL then BUY … only
//══════════════════════════════════════════════════════════════════════════════
var int   lastSide = 0          // 1 buy, -1 sell
var float lastSigPrice = na
var int   lastSigBar = na
var float entryPrice = na
var float stopPrice = na
var float t1Price = na
var float t2Price = na
var string activeTrade = "FLAT"
var float confidence = 0.0

swingFromLastPh = not na(lastPh) ? lastPh - pl : atr * 10
swingFromLastPl = not na(lastPl) ? ph - lastPl : atr * 10
moveFromLast = not na(lastSigPrice) ? math.abs((not na(pl) ? pl : ph) - lastSigPrice) : atr * 10

// Trend gate: in strong trend, block weak counter-trend pivots unless at projection extreme + divergence/rejection
allowLong = true
allowShort = true
if useTrendGate and adx >= adxTrend
    if bias == "Extremely Bullish" or bias == "Buy"
        // Shorts only at true exhaustion near proj high
        allowShort := nearDayHigh and (bearDiv or bearReject or pRsi >= rsiSellMin)
    if bias == "Extremely Bearish" or bias == "Sell"
        allowLong := nearDayLow and (bullDiv or bullReject or pRsi <= rsiBuyMax)

// Candidate quality scores 0–100
longScore = 0.0
shortScore = 0.0

isPivotLow = not na(pl) and barstate.isconfirmed
isPivotHigh = not na(ph) and barstate.isconfirmed

if isPivotLow
    longScore += 25.0  // confirmed swing low
    longScore += swingFromLastPh >= atr * minSwingAtr ? 15.0 : -50.0
    longScore += pRsi <= rsiBuyMax ? 15.0 : pRsi <= 50 ? 5.0 : -20.0
    longScore += nearDayLow ? 15.0 : -15.0
    longScore += bullReject ? 10.0 : 0.0
    longScore += bullDiv ? 15.0 : useDivFilter ? 0.0 : 5.0
    longScore += (close > pLow and close >= pClose) ? 5.0 : 0.0  // structure holding after pivot
    longScore += allowLong ? 0.0 : -100.0
    longScore += (lastSide == 0 or lastSide == -1) ? 0.0 : -100.0
    longScore += na(lastSigPrice) or (lastSigPrice - pl) >= atr * minReverseAtr or lastSide == 0 ? 0.0 : -100.0

if isPivotHigh
    shortScore += 25.0
    shortScore += swingFromLastPl >= atr * minSwingAtr ? 15.0 : -50.0
    shortScore += pRsi >= rsiSellMin ? 15.0 : pRsi >= 50 ? 5.0 : -20.0
    shortScore += nearDayHigh ? 15.0 : -15.0
    shortScore += bearReject ? 10.0 : 0.0
    shortScore += bearDiv ? 15.0 : useDivFilter ? 0.0 : 5.0
    shortScore += (close < pHigh and close <= pClose) ? 5.0 : 0.0
    shortScore += allowShort ? 0.0 : -100.0
    shortScore += (lastSide == 0 or lastSide == 1) ? 0.0 : -100.0
    shortScore += na(lastSigPrice) or (ph - lastSigPrice) >= atr * minReverseAtr or lastSide == 0 ? 0.0 : -100.0

// Pass threshold — institutional bar
passScore = 70.0
buySignal = isPivotLow and longScore >= passScore
sellSignal = isPivotHigh and shortScore >= passScore

// Resolve rare dual confirm same bar
if buySignal and sellSignal
    if lastSide == -1
        sellSignal := false
    else if lastSide == 1
        buySignal := false
    else
        if longScore >= shortScore
            sellSignal := false
        else
            buySignal := false

if buySignal
    lastSide := 1
    lastSigPrice := pl
    lastSigBar := bar_index - rightBars
    entryPrice := pl
    stopPrice := pl - atr * stopAtrMult
    riskL = entryPrice - stopPrice
    t1Price := entryPrice + riskL * t1R
    t2Cand = entryPrice + riskL * t2R
    t2Price := math.min(math.max(t2Cand, vwap + atr), math.max(sellZoneBot, projHigh))
    activeTrade := "Long"
    confidence := math.min(98.0, longScore)

if sellSignal
    lastSide := -1
    lastSigPrice := ph
    lastSigBar := bar_index - rightBars
    entryPrice := ph
    stopPrice := ph + atr * stopAtrMult
    riskS = stopPrice - entryPrice
    t1Price := entryPrice - riskS * t1R
    t2CandS = entryPrice - riskS * t2R
    t2Price := math.max(t2CandS, math.min(buyZoneTop, math.max(projLow, vwap - atr)))
    activeTrade := "Short"
    confidence := math.min(98.0, shortScore)

// Clear or update active trade lifecycle (non-repaint: based on close)
if activeTrade == "Long"
    if not na(stopPrice) and close <= stopPrice
        activeTrade := "FLAT"
    else if not na(t2Price) and close >= t2Price
        activeTrade := "FLAT"
else if activeTrade == "Short"
    if not na(stopPrice) and close >= stopPrice
        activeTrade := "FLAT"
    else if not na(t2Price) and close <= t2Price
        activeTrade := "FLAT"

//══════════════════════════════════════════════════════════════════════════════
// PLOT SIGNALS AT THE ACTUAL SWING (non-repaint once confirmed)
//══════════════════════════════════════════════════════════════════════════════
if buySignal
    label.new(bar_index - rightBars, pl, "BUY", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=bullCol, textcolor=color.white, size=size.normal)
if sellSignal
    label.new(bar_index - rightBars, ph, "SELL", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=bearCol, textcolor=color.white, size=size.normal)

// Active trade levels
var line lnEntry = na
var line lnStop = na
var line lnT1 = na
var line lnT2 = na

if showTradeLvls and (buySignal or sellSignal)
    if not na(lnEntry)
        line.delete(lnEntry)
    if not na(lnStop)
        line.delete(lnStop)
    if not na(lnT1)
        line.delete(lnT1)
    if not na(lnT2)
        line.delete(lnT2)
    x1 = bar_index - rightBars
    col = buySignal ? bullCol : bearCol
    lnEntry := line.new(x1, entryPrice, bar_index + 20, entryPrice, color=col, style=line.style_solid, width=2)
    lnStop := line.new(x1, stopPrice, bar_index + 20, stopPrice, color=color.new(bearCol, 0), style=line.style_dotted, width=1)
    lnT1 := line.new(x1, t1Price, bar_index + 20, t1Price, color=color.new(bullCol, 20), style=line.style_dashed, width=1)
    lnT2 := line.new(x1, t2Price, bar_index + 20, t2Price, color=color.new(bullCol, 0), style=line.style_dashed, width=1)

if showTradeLvls and not na(lnEntry) and not (buySignal or sellSignal)
    line.set_x2(lnEntry, bar_index + 2)
    if not na(lnStop)
        line.set_x2(lnStop, bar_index + 2)
    if not na(lnT1)
        line.set_x2(lnT1, bar_index + 2)
    if not na(lnT2)
        line.set_x2(lnT2, bar_index + 2)

plot(ema21, "EMA 21", color=color.new(#787B86, 55))

//══════════════════════════════════════════════════════════════════════════════
// WHAT TO DO?
//══════════════════════════════════════════════════════════════════════════════
whatToDo = "Wait"
if activeTrade == "Long"
    whatToDo := close <= stopPrice ? "Long stopped — wait SELL setup" : close >= t2Price ? "Long T2 hit — take profit / wait SELL" : close >= t1Price ? "Long T1 hit — trail / bank partials" : "Hold Long — manage to T1/T2"
else if activeTrade == "Short"
    whatToDo := close >= stopPrice ? "Short stopped — wait BUY setup" : close <= t2Price ? "Short T2 hit — take profit / wait BUY" : close <= t1Price ? "Short T1 hit — trail / bank partials" : "Hold Short — manage to T1/T2"
else
    if bias == "Chop"
        whatToDo := "Chop — only fade BUY/SELL zones, small size"
    else if bias == "Extremely Bullish"
        whatToDo := "Only BUY pullbacks into BUY ZONE"
    else if bias == "Extremely Bearish"
        whatToDo := "Only SELL rallies into SELL ZONE"
    else if bias == "Buy"
        whatToDo := "Bias Buy — wait BUY at zone / confirmed low"
    else if bias == "Sell"
        whatToDo := "Bias Sell — wait SELL at zone / confirmed high"
    else
        whatToDo := "Neutral — wait confirmed extreme + signal"

// Pending suggestion when flat / looking for next
sugTrade = activeTrade
sugEntry = entryPrice
sugStop = stopPrice
sugT1 = t1Price
sugT2 = t2Price
sugConf = confidence

if activeTrade == "FLAT" or (activeTrade == "Long" and close <= nz(stopPrice, close)) or (activeTrade == "Short" and close >= nz(stopPrice, close))
    // Suggest next planned trade from zones
    if lastSide == 1 or (lastSide == 0 and (bias == "Sell" or bias == "Extremely Bearish"))
        sugTrade := "Short"
        sugEntry := sellZoneBot
        sugStop := sellZoneTop + atr * stopAtrMult
        r = sugStop - sugEntry
        sugT1 := sugEntry - r * t1R
        sugT2 := math.max(sugEntry - r * t2R, projLow)
        sugConf := bias == "Extremely Bearish" ? 75.0 : bias == "Sell" ? 65.0 : bias == "Chop" ? 55.0 : 50.0
    else
        sugTrade := "Long"
        sugEntry := buyZoneTop
        sugStop := buyZoneBot - atr * stopAtrMult
        r = sugEntry - sugStop
        sugT1 := sugEntry + r * t1R
        sugT2 := math.min(sugEntry + r * t2R, projHigh)
        sugConf := bias == "Extremely Bullish" ? 75.0 : bias == "Buy" ? 65.0 : bias == "Chop" ? 55.0 : 50.0

// If in active trade, suggestion mirrors live levels
if activeTrade == "Long" and close > nz(stopPrice, close)
    sugTrade := "Long"
    sugEntry := entryPrice
    sugStop := stopPrice
    sugT1 := t1Price
    sugT2 := t2Price
    sugConf := confidence
if activeTrade == "Short" and close < nz(stopPrice, close)
    sugTrade := "Short"
    sugEntry := entryPrice
    sugStop := stopPrice
    sugT1 := t1Price
    sugT2 := t2Price
    sugConf := confidence

confLabel = sugConf >= 85 ? "VERY HIGH" : sugConf >= 75 ? "HIGH" : sugConf >= 65 ? "MEDIUM" : sugConf >= 55 ? "LOW" : "VERY LOW"

//══════════════════════════════════════════════════════════════════════════════
// DASHBOARD TOP-RIGHT
// Bias | Projected Day Range | Projected Day High/Low | What to do?
//══════════════════════════════════════════════════════════════════════════════
var table topDash = table.new(position.top_right, 2, 5, bgcolor=color.new(#101418, 5), border_width=1, border_color=color.new(#546E7A, 40))

if barstate.islast
    table.cell(topDash, 0, 0, "BIAS", text_color=color.gray, text_size=size.small)
    table.cell(topDash, 1, 0, bias, text_color=biasCol, text_size=size.normal)

    table.cell(topDash, 0, 1, "Projected Day Range", text_color=color.gray, text_size=size.small)
    table.cell(topDash, 1, 1, str.tostring(projRange, format.mintick), text_color=color.white, text_size=size.small)

    table.cell(topDash, 0, 2, "Projected Day High", text_color=color.gray, text_size=size.small)
    table.cell(topDash, 1, 2, str.tostring(projHigh, format.mintick), text_color=bearCol, text_size=size.small)

    table.cell(topDash, 0, 3, "Projected Day Low", text_color=color.gray, text_size=size.small)
    table.cell(topDash, 1, 3, str.tostring(projLow, format.mintick), text_color=bullCol, text_size=size.small)

    table.cell(topDash, 0, 4, "What to do?", text_color=color.gray, text_size=size.small)
    table.cell(topDash, 1, 4, whatToDo, text_color=color.white, text_size=size.tiny)

//══════════════════════════════════════════════════════════════════════════════
// DASHBOARD BOTTOM-RIGHT — Trade suggestion
//══════════════════════════════════════════════════════════════════════════════
var table botDash = table.new(position.bottom_right, 2, 7, bgcolor=color.new(#101418, 5), border_width=1, border_color=color.new(#546E7A, 40))

if barstate.islast
    table.cell(botDash, 0, 0, "TRADE", text_color=color.gray, text_size=size.small)
    table.cell(botDash, 1, 0, sugTrade, text_color=sugTrade == "Long" ? bullCol : sugTrade == "Short" ? bearCol : color.gray, text_size=size.normal)

    table.cell(botDash, 0, 1, "Entry", text_color=color.gray, text_size=size.small)
    table.cell(botDash, 1, 1, na(sugEntry) ? "—" : str.tostring(sugEntry, format.mintick), text_color=color.white, text_size=size.small)

    table.cell(botDash, 0, 2, "Stop", text_color=color.gray, text_size=size.small)
    table.cell(botDash, 1, 2, na(sugStop) ? "—" : str.tostring(sugStop, format.mintick), text_color=bearCol, text_size=size.small)

    table.cell(botDash, 0, 3, "Target 1", text_color=color.gray, text_size=size.small)
    table.cell(botDash, 1, 3, na(sugT1) ? "—" : str.tostring(sugT1, format.mintick), text_color=bullCol, text_size=size.small)

    table.cell(botDash, 0, 4, "Target 2", text_color=color.gray, text_size=size.small)
    table.cell(botDash, 1, 4, na(sugT2) ? "—" : str.tostring(sugT2, format.mintick), text_color=bullCol, text_size=size.small)

    table.cell(botDash, 0, 5, "Confidence", text_color=color.gray, text_size=size.small)
    table.cell(botDash, 1, 5, confLabel + " (" + str.tostring(sugConf, "#.0") + ")", text_color=sugConf >= 75 ? bullCol : sugConf >= 60 ? color.orange : bearCol, text_size=size.small)

    table.cell(botDash, 0, 6, "R:R to T2", text_color=color.gray, text_size=size.small)
    rr = not na(sugEntry) and not na(sugStop) and math.abs(sugEntry - sugStop) > 0 ? math.abs(sugT2 - sugEntry) / math.abs(sugEntry - sugStop) : na
    table.cell(botDash, 1, 6, na(rr) ? "—" : str.tostring(rr, "#.00") + "R", text_color=color.white, text_size=size.small)

//══════════════════════════════════════════════════════════════════════════════
// ALERTS (confirmed bar only)
//══════════════════════════════════════════════════════════════════════════════
alertcondition(buySignal, title="BUY (confirmed pivot)", message="IALGO BUY confirmed on {{ticker}}")
alertcondition(sellSignal, title="SELL (confirmed pivot)", message="IALGO SELL confirmed on {{ticker}}")
